rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // By default, deny all reads and writes.
    match /{document=**} {
      allow read, write: if false;
    }

    // Allow public access to the inventory for now.
    // TODO: Secure this for authenticated users.
    match /inventory/{productId} {
      allow read, write: if true;
    }

    // Allow public access to completed sales for now.
    // TODO: Secure this for authenticated users.
    match /completedSales/{saleId} {
      allow read, write: if true;
    }
  }
}
