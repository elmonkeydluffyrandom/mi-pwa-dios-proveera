{
  "entities": {
    "product": {
      "title": "Product",
      "description": "Represents a product in the inventory.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the product."
        },
        "price": {
          "type": "number",
          "description": "The price of the product."
        },
        "category": {
          "type": "string",
          "description": "The category of the product."
        }
      },
      "required": ["name", "price", "category"]
    },
    "saleItem": {
      "title": "Sale Item",
      "description": "Represents an item within a completed sale.",
      "type": "object",
      "properties": {
        "productId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "price": {
          "type": "number"
        },
        "quantity": {
          "type": "number"
        },
        "subtotal": {
          "type": "number"
        },
        "category": {
          "type": "string"
        }
      },
      "required": ["productId", "name", "price", "quantity", "subtotal", "category"]
    },
    "completedSale": {
      "title": "Completed Sale",
      "description": "Represents a completed sale transaction.",
      "type": "object",
      "properties": {
        "date": {
          "type": "string",
          "format": "date-time",
          "description": "The timestamp of when the sale was completed."
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/entities/saleItem"
          }
        },
        "total": {
          "type": "number",
          "description": "The total amount of the sale."
        }
      },
      "required": ["date", "items", "total"]
    }
  },
  "auth": {
    "providers": []
  },
  "firestore": {
    "/inventory/{productId}": {
      "schema": {
        "$ref": "#/entities/product"
      },
      "description": "Stores all products in the inventory."
    },
    "/completedSales/{saleId}": {
      "schema": {
        "$ref": "#/entities/completedSale"
      },
      "description": "Stores all completed sale records."
    }
  }
}
